# 관리자 화면 비밀번호 (/admin) — 반드시 긴 비밀번호로 바꾸세요
ADMIN_PASSWORD=change-me
# 관리자 로그인 쿠키 서명용 임의 문자열 (32자 이상)
SESSION_SECRET=replace-with-a-long-random-string

# 데이터 저장소: Vercel Marketplace의 Upstash Redis를 프로젝트에 연결하면 아래 두 값이 자동으로 들어갑니다.
# 비워 두면 로컬 개발용으로 .data/db.json 파일에 저장합니다 (Vercel 배포 환경에서는 저장되지 않음).
KV_REST_API_URL=
KV_REST_API_TOKEN=

